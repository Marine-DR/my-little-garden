{
  "name": "my-little-garden",
  "version": "0.4.0",
  "description": "Desktop gardening planner for designing and selecting plants",
  "author": "My Little Garden contributors",
  "desktopName": "My Little Garden",
  "private": true,
  "workspaces": [
    "packages/communication",
    "packages/core",
    "packages/database",
    "packages/photo-handling"
  ],
  "main": "dist/main/main/main.js",
  "scripts": {
    "build:core": "tsc -p packages/core/tsconfig.json",
    "build:communication": "npm run build:core && tsc -p packages/communication/tsconfig.json",
    "build:photo": "tsc -p packages/photo-handling/tsconfig.json",
    "build:database": "npm run build:communication && npm run build:photo && tsc -p packages/database/tsconfig.json",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:desktop": "npm run build:database && vite build && tsc -p apps/desktop/tsconfig.json && npm run build:preload",
    "dist": "npm run build:desktop && electron-builder",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run build:database && tsc -p packages/core/tsconfig.json --noEmit && tsc -p packages/database/tsconfig.json --noEmit && tsc -p apps/desktop/tsconfig.json --noEmit && tsc -p apps/desktop/tsconfig.renderer.json --noEmit && tsc -p apps/desktop/tsconfig.tests.json --noEmit",
    "lint": "prettier --check . && eslint . && npm run lint:design-system",
    "lint:design-system": "node scripts/check-design-system.cjs",
    "lint:fix": "prettier --write . && eslint . --fix",
    "test:core": "npm run build:core && node --test packages/core/tests/*.test.cjs",
    "test:photo": "npm run build:photo && node --test packages/photo-handling/tests/*.test.cjs",
    "test:database": "npm run build:database && node --test packages/database/tests/*.test.cjs",
    "test:desktop": "vitest run",
    "test": "npm run lint && npm run typecheck && npm run test:core && npm run test:photo && npm run test:database && npm run test:desktop",
    "start": "npm run build:desktop && node scripts/start-electron.cjs",
    "demo": "npm run build:desktop && node scripts/start-electron.cjs --demo"
  },
  "build": {
    "appId": "com.mylittlegarden.desktop",
    "productName": "My Little Garden",
    "icon": "apps/desktop/src/renderer/assets/app-icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "apps/desktop/resources/**",
      "packages/**",
      "scripts/**",
      "package.json",
      "package-lock.json"
    ],
    "extraResources": [
      {
        "from": "apps/desktop/resources",
        "to": "resources"
      },
      {
        "from": "apps/desktop/src/renderer/assets/app-icon.png",
        "to": "app-icon.png"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "syncDesktopName": true,
      "icon": "apps/desktop/src/renderer/assets/app-icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "apps/desktop/src/renderer/assets/app-icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "apps/desktop/src/renderer/assets/app-icon.png"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@my-little-garden/communication": "*",
    "@my-little-garden/core": "*",
    "@my-little-garden/database": "*",
    "@my-little-garden/photo-handling": "*",
    "fabric": "^7.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  }
}
