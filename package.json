{
  "name": "my-little-garden",
  "version": "0.2.0",
  "description": "Desktop gardening planner for designing and selecting plants",
  "author": "My Little Garden contributors",
  "desktopName": "My Little Garden",
  "private": true,
  "workspaces": [
    "packages/communication",
    "packages/core",
    "packages/database",
    "packages/photo-handling"
  ],
  "main": "dist/main/main/main.js",
  "scripts": {
    "build": "tsc -b --builders 4",
    "build:core": "tsc -b packages/core/tsconfig.json",
    "build:communication": "tsc -b packages/communication/tsconfig.json --builders 2",
    "build:photo": "tsc -b packages/photo-handling/tsconfig.json --builders 2",
    "build:database": "tsc -b packages/database/tsconfig.json --builders 2",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:desktop": "npm run build && vite build && npm run build:preload",
    "dist": "npm run build:desktop && electron-builder",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --builders 4 && tsc -p apps/desktop/tsconfig.renderer.json --noEmit --checkers 4 && tsc -p apps/desktop/tsconfig.tests.json --noEmit --checkers 4",
    "lint": "prettier --check . && oxlint",
    "lint:fix": "prettier --write . && oxlint --fix",
    "test:core": "npm run build:core && node packages/core/tests/plant.test.cjs",
    "test:database": "npm run build:database && node --test packages/database/tests/initial-schema.test.cjs packages/database/tests/catalog-repository.test.cjs packages/database/tests/selection-repository.test.cjs",
    "test:desktop": "vitest run",
    "test": "npm run lint && npm run typecheck && npm run test:core && npm run test:database && npm run test:desktop",
    "start": "npm run build:desktop && node scripts/start-electron.cjs",
    "demo": "npm run build:desktop && node scripts/start-electron.cjs --demo"
  },
  "build": {
    "appId": "com.mylittlegarden.desktop",
    "productName": "My Little Garden",
    "icon": "apps/desktop/src/renderer/assets/app-icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "apps/desktop/resources/**",
      "packages/**",
      "scripts/**",
      "package.json",
      "package-lock.json"
    ],
    "extraResources": [
      {
        "from": "apps/desktop/resources",
        "to": "resources"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "syncDesktopName": true,
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "apps/desktop/src/renderer/assets/app-icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "apps/desktop/src/renderer/assets/app-icon.png"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@my-little-garden/core": "*",
    "@my-little-garden/communication": "*",
    "@my-little-garden/database": "*",
    "@my-little-garden/photo-handling": "*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
